{
  "info": {
    "name": "Laboratorio - Crud completo",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "usuarioId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Crear usuario de prueba",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/usuarios",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Usuario de prueba\",\n  \"email\": \"prueba@example.com\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Usuario creado\", () => { pm.response.to.have.status(200); pm.expect(pm.response.json().id).to.be.a(\"number\"); });",
              "if (pm.response.code === 200) pm.collectionVariables.set(\"usuarioId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Editar usuario",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/usuarios/{{usuarioId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Usuario editado\",\n  \"email\": \"editado@example.com\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Edicion correcta\", () => { pm.response.to.have.status(200); const u = pm.response.json(); pm.expect(String(u.id)).to.eql(String(pm.collectionVariables.get(\"usuarioId\"))); pm.expect(u.nombre).to.eql(\"Usuario editado\"); pm.expect(u.email).to.eql(\"editado@example.com\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Eliminar logicamente",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/usuarios/{{usuarioId}}/logico"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Baja logica: 204\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Verificar usuario oculto",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/usuarios"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"El usuario inactivo no aparece\", () => { pm.response.to.have.status(200); pm.expect(pm.response.json().some(u => String(u.id) === String(pm.collectionVariables.get(\"usuarioId\")))).to.eql(false); });"
            ]
          }
        }
      ]
    },
    {
      "name": "5. No editar usuario inactivo",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/usuarios/{{usuarioId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"No debe cambiar\",\n  \"email\": \"otro@example.com\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Usuario inactivo: 404\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Borrar fisicamente el usuario inactivo",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/usuarios/{{usuarioId}}/fisico"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Borrado fisico: 204\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Confirmar que el registro ya no existe",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/usuarios/{{usuarioId}}/logico"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Registro inexistente: 404\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    }
  ]
}
